# Dung lượng mục tiêu (hỗ trợ B, KB, MB, GB — mặc định MB nếu không ghi đơn vị)
MIN_SIZE_MB=1MB
MAX_SIZE_MB=5MB

# Làm nét nhẹ (UnsharpMask) trước khi tăng dung lượng — không thêm viền
SHARPEN=1

# Phóng to tối đa ~15% nếu vẫn dưới MIN sau nén JPEG chất lượng cao
ALLOW_UPSCALE=1
MAX_UPSCALE_RATIO=1.15

# 0 = 4:4:4 (file JPEG lớn hơn, nét hơn); 2 = 4:2:0 (mặc định Pillow)
JPEG_SUBSAMPLING=0

# Xoá watermark www.hcmut.edu.vn trên ảnh thẻ myBk (crawl-profile-image-mybk)
REMOVE_WATERMARK=1
# Số chữ watermark tối thiểu dò được để coi là ảnh có watermark
WATERMARK_MIN_HITS=8
# Mức làm sáng tối đa = hệ số x độ đậm đo được của từng chữ (cao = sạch hơn, thấp = an toàn hơn cho mắt/lông mày)
WATERMARK_STRENGTH=1.3
# Số lượt dò + xoá (mỗi lượt dọn tiếp vết còn sót)
WATERMARK_PASSES=4

# Làm nét bằng Real-ESRGAN (resizer/models/realesr-general-x4v3.onnx), chạy sau khi xoá watermark
ENHANCE=1
# Ảnh đầu ra lớn gấp bao nhiêu lần ảnh gốc (1–4)
ENHANCE_SCALE=2
# Tỉ lệ ảnh từ model (1 = nét nhất; thấp hơn = giữ kết cấu da tự nhiên hơn)
ENHANCE_BLEND=0.8
# Chỉ làm nét ảnh có cạnh dài <= giá trị này (px); ảnh lớn đã đủ nét, xử lý sẽ rất chậm
ENHANCE_MAX_SIDE=1200
